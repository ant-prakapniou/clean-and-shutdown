<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

	<!--
    Application identity. The name should match the assembly name
    configured in the .csproj. type="win32" is required for
    native-style manifests.
  -->
	<assemblyIdentity version="1.0.0.0" name="CleanAndShutdown" type="win32" />

	<!--
    Elevation. requireAdministrator forces Windows to show a UAC
    prompt at launch. Without elevation, System Temp and the Windows
    Update cache cannot be cleaned.
  -->
	<trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
		<security>
			<requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
				<requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
			</requestedPrivileges>
		</security>
	</trustInfo>

	<!--
    OS compatibility. Declares support for Windows 10 and Windows 11.
    The GUID is the well-known identifier for that OS family.
  -->
	<compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
		<application>
			<supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
		</application>
	</compatibility>

	<!--
    Windows settings.

    longPathAware        Enables paths longer than MAX_PATH (260 chars)
                         without the \\?\ prefix on Windows 10 1607+.
                         Requires the LongPathsEnabled policy to be
                         turned on system-wide.

    activeCodePage=UTF-8 Sets UTF-8 as the process code page on
                         Windows 10 1903+, so non-ASCII characters in
                         paths and logs render correctly.
  -->
	<application xmlns="urn:schemas-microsoft-com:asm.v3">
		<windowsSettings>
			<longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
			<activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
		</windowsSettings>
	</application>

</assembly>